{
    "name": "softspring/armonic",
    "description": "A powerful Symfony CMS",
    "license": "AGPL-3.0-or-later",
    "type": "library",
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "softspring/cms-bundle": "^6.0@dev",
        "softspring/cms-translation-plugin": "^6.0@dev",
        "softspring/cms-module-collection": "^6.0@dev",
        "symfony/http-kernel": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^1.10.49 || ^2.0.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Softspring\\Armonic\\": "src"
        }
    }
}
